# CPU-only runtime image for the Decider candidate. Built ONLY on a GitHub-hosted runner (cce-jev-prepare / cce-jev-eval).
# No model weights inside the image: the verified bundle is bind-mounted read-only at run time.
# Base digest is the manifest-list digest recorded in locks/cpu-runtime.lock.json.
FROM python:3.11-slim-bookworm@sha256:a36c24f9cbdf4fd0f52d67f0823eeac19c2028c637cecc392d97f980d4fec56b

ENV PIP_NO_CACHE_DIR=1 PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1 \
    TOKENIZERS_PARALLELISM=false OMP_NUM_THREADS=3 MKL_NUM_THREADS=3

RUN useradd --uid 1001 --user-group --create-home runner

# runtime-cpu.lock.txt: exact versions + sha256 hashes (generated by prepare on GitHub). decider-ai: installed --no-deps from the
# pinned upstream commit (DECIDER_REF, verified against locks/model.source.lock.json.source_revision by the workflow).
# WITH_DECIDER=0 (the hf_choice candidate workflows): same locked wheels, no decider package and no git fetch at build time —
# hf_choice never imports decider, and the build then has no external git dependency after a permit is consumed.
ARG DECIDER_REF
ARG WITH_DECIDER=1
COPY runtime-cpu.lock.txt /tmp/runtime-cpu.lock.txt
RUN if [ "$WITH_DECIDER" = "1" ]; then apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*; fi \
 && python -m pip install --no-cache-dir --require-hashes --no-deps -r /tmp/runtime-cpu.lock.txt \
 && if [ "$WITH_DECIDER" = "1" ]; then python -m pip install --no-cache-dir --no-deps "decider-ai @ git+https://github.com/Mapika/decider@${DECIDER_REF}" \
      && apt-get purge -y git && apt-get autoremove -y; fi \
 && rm -rf /tmp/runtime-cpu.lock.txt \
 && if [ "$WITH_DECIDER" = "1" ]; then python -c "import torch, transformers, decider.infer, decider.systemone; print('torch', torch.__version__, 'transformers', transformers.__version__)"; \
    else python -c "import torch, transformers, safetensors, tokenizers; print('torch', torch.__version__, 'transformers', transformers.__version__)"; fi \
 && python -m pip freeze --all > /opt/sbom.txt

USER 1001:1001
WORKDIR /work
ENTRYPOINT ["python3"]
