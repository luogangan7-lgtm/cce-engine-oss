{
  "schema_name": "cce_foundation_contract",
  "version": "2.0.0",
  "status": "active",
  "root_kind": "cce.analysis_case.v2",
  "purpose": "CCE 通用测量交换契约：区分刺激读出、已观察响应读出和有证据前态条件下的状态转移；主体实体不作为答案输入，但带时间和证据的状态快照可以条件化 transition measurement。",
  "measurement_modes": {
    "stimulus": {
      "input": "Event + Universal Context",
      "output": "derived dynamic distribution",
      "forbidden": ["pre_state_snapshot_ref", "post_state_snapshot_ref", "state_transition_ref"]
    },
    "observed_response": {
      "input": "Observed response Event + Universal Context",
      "output": "derived text distribution and optional inferred state hypothesis",
      "forbidden": ["pre_state_snapshot_ref", "post_state_snapshot_ref", "state_transition_ref"]
    },
    "transition": {
      "input": "Event + Universal Context + evidence-bound pre_state_snapshot_ref",
      "output": "state_before -> state_after -> delta",
      "required": ["pre_state_snapshot_ref", "state_transition_ref"]
    }
  },
  "universal_context_dimensions": [
    "time",
    "location",
    "environment",
    "device",
    "session",
    "social",
    "relationship",
    "life",
    "task",
    "current_goal"
  ],
  "subject_time_scales": {
    "core": "稳定量；只由可追溯更正改变。",
    "identity": "append-only 累加量。",
    "state": "带时间、证据、认识论标签和持续性的瞬时量。"
  },
  "required_records": {
    "content": ["id", "format", "source", "content_hash"],
    "observation": ["id", "kind", "assertion", "evidence_refs", "provenance"],
    "event": ["id", "event_type", "layer", "assertion", "member_refs", "evidence_refs", "confidence"],
    "context_snapshot": ["id", "observed_at", "summary", "dimensions", "provenance"],
    "state_snapshot": ["id", "subject_ref", "observed_at", "assertion", "dimensions", "evidence_refs", "confidence", "temporal_scope"],
    "cce_request": ["id", "measurement_mode", "measurement_adapter", "event_refs", "context_snapshot_ref", "prediction_time"],
    "measurement_result": ["id", "request_ref", "assertion", "model_version", "input_fingerprint", "confidence", "evidence_refs"],
    "state_transition": ["id", "request_ref", "pre_state_snapshot_ref", "post_state_snapshot_ref", "delta", "evidence_refs", "confidence"],
    "outcome": ["id", "exposure_ref", "observed_at", "metric", "value", "provenance"]
  },
  "hard_gates": {
    "no_subject_answer_input": "subject_refs/profile_version/subject_version 仍禁止进入 CCE 请求。transition 只接受有证据且带时间的 pre_state_snapshot_ref。",
    "no_outcome_leakage": "发布后曝光、互动、行为和商业结果不得成为同一次 ex-ante 测量输入。",
    "transition_exactness": "delta 的键必须等于前后状态共同维度，且数值必须等于 after-before。",
    "epistemic_boundary": "文本/行为是 observed evidence；由它推断的心理状态必须标 inferred，模型分布必须标 derived。",
    "context_not_platform_only": "Context 至少显式声明一个 Universal Context dimension；platform/surface 只是可选平台场景。"
  },
  "event_relations_v1": [
    "precedes",
    "follows",
    "overlaps",
    "synchronizes",
    "supports",
    "reinforces",
    "conflicts",
    "contrasts",
    "masks",
    "amplifies",
    "attenuates",
    "substitutes"
  ],
  "storage": "append-only JSON/JSONL + PostgreSQL indexes; vectors remain optional retrieval indexes, never the fact source."
}
