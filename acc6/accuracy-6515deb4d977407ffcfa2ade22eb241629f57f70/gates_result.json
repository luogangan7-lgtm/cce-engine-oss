  "diagnosis": {
   "pairs": [
    {
     "pair": "display|pain_seek",
     "ambiguity": "congruence(促进vs威胁)需要揣测情绪,target_layer(identity vs consumption_goal)是元层级无法从表层文本直读;两类的'详述自己设备/步骤'在文本表层完全同构,coping=高、time=现在两项也全重叠。",
     "hard_discriminant": "看末句是否含求助动议:pain_seek必含疑问句尾或显式请求('any fix?'/'how do I...?'/'还有救吗')或'已试步骤'的列举+回报;display无求助问句,末句是评价/对比/承诺('works well'/'still better than X'/'will report back')。判别式:首句若是问题→pain_seek;首句若是'我也用X'或'我试了Y'→display。"
    },
    {
     "pair": "audit|pain_seek",
     "ambiguity": "congruence=威胁、need_status=未满足、coping=高、time=现在四项全重叠;区分仅靠attribution(other_agent vs system/none)与target_layer(epistemic_trust vs consumption_goal),但厂商/说明书/门店既可被识别为other_agent也可被识别为system,且目标层是元属性。",
     "hard_discriminant": "看质询对象的语义指向:audit指向'陈述/承诺的真值'——'spec says X,真的X吗?'/'audiologist说Y,实际Y吗?'/'manual遗漏了Z';pain_seek指向'功能的可用性'——'X不工作'/'Y断连'/'Z不兼容'。判别式:含'对'X'的陈述/标签/承诺'的怀疑→audit;含'对'X'的行为/输出/连接'的失败→pain_seek。"
    },
    {
     "pair": "display|itch",
     "ambiguity": "congruence=促进、attribution=none、target_layer=identity三项全重叠;区分仅靠need_status(已满足vs未满足但不迫切)、time(现在vs未来)、coping(高vs中)三个推断性字段,而'我用的是X'与'我在考虑X'在描述表层仅差一个动词时态。",
     "hard_discriminant": "看时态锚点和拥有动词:display必含现在完成/进行时+拥有/迁移动词('I have'/'I'm on'/'I switched from A to B because')+至少一处具体型号/参数落地;itch必含虚拟/将来/条件时态+意向动词('I'd like'/'if I were to'/'wondering whether'/'considering'),无具体已购型号。判别式:出现具体已购型号+主观打分→display;仅有品类或意向→itch。"
    },
    {}
   ]
  }
